# Required — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Google OAuth (optional — needed for "Continue with Google" on login/signup)
# Get these from https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://localhost:3000/api/auth/google/callback"

# UPC product lookup (all configured providers run in parallel on every scan)
# Go-UPC - optional paid provider and preferred result when configured.
# Get a key at: https://go-upc.com/
GO_UPC_API_KEY=""

# Open Food Facts — always used, free, no key needed.
# UPCitemDB — trial endpoint used automatically with no key (100 requests/day limit).
#   Set this key to upgrade to the paid /v1 endpoint (no rate limit).
#   Get a key at: https://www.upcitemdb.com/
UPCITEMDB_API_KEY=""

# REQUIRED: set to "production" before deploying.
# Demo seed accounts are never created unless ALLOW_DEMO_SEED is explicitly true.
NODE_ENV=""

# Port to listen on. Hosting platforms usually set this; defaults to 3000.
PORT=""

# Public HTTPS origin phones open from the scan QR code, e.g. https://scan.example.com
# Required in production: without it
# the QR code points at the tunnel or this machine's LAN address.
PUBLIC_BASE_URL=""

# Which proxies may set X-Forwarded-For (used for rate limiting and secure cookies).
# Default: proxies on loopback/private networks (local tunnel, a load balancer inside the VPC).
# Use a hop count when the chain is fixed, e.g. "2" for CloudFront in front of an ALB.
TRUST_PROXY=""

# Local/demo only. Creates known demo credentials: admin/taker/superadmin.
# NEVER enable this in production.
ALLOW_DEMO_SEED=""

# Cloudflare tunnel hostname (optional — tightens Vite HMR allowedHosts in dev)
# Set to the exact hostname from your tunnel, e.g. my-tunnel.trycloudflare.com
# Also routes the dev HMR socket through the tunnel's port 443; leave unset when phones
# open the dev server directly (LAN or Tailscale IP).
TUNNEL_HOST=""

# Set to "true" to disable Vite HMR (hot module reload) in dev.
# Useful when running behind a tunnel that doesn't support WebSocket upgrades.
DISABLE_HMR=""
